# Copy to .env and fill in. Never share or commit .env.
OWNER_NAME=YourName
# Leave empty when EV runs on your own number (Coexistence).
# Only for a two-number setup: your personal WhatsApp, digits only (e.g. 919876543210)
OWNER_PHONE=
# Your timezone, so "tomorrow 5pm" means your 5pm (e.g. Europe/London, America/New_York)
TIMEZONE=
# Where you and most of your contacts are, so answers are local (e.g. London, UK)
REGION=

# From developers.facebook.com -> your app -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=
# Permanent token from a System User (Business Settings -> Users -> System users)
WA_TOKEN=
# App settings -> Basic -> App secret
WA_APP_SECRET=
# Any long random string; paste the same value into the webhook setup on Meta
WA_VERIFY_TOKEN=
GRAPH_VERSION=v25.0

# AI: "ollama" runs models on the server (needs ~8 GB+ RAM); "gemini" uses Google's free API (tiny servers OK)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
CHAT_MODEL=qwen2.5:7b

# Web search: ddgs (free, no key) or brave (more reliable; free key at api-dashboard.search.brave.com)
SEARCH_PROVIDER=ddgs
BRAVE_API_KEY=

# Dashboard: https://<server>/dashboard  (any username + this password). Use a long random password.
DASHBOARD_PASSWORD=
# How long EV waits so you can answer first, and how long it stays quiet after you reply yourself
REPLY_DELAY_SECONDS=120
TAKEOVER_HOURS=3

# Only in the .env on your Mac (for sync_reminders.py): the URL setup.sh printed, without /webhook
EV_SERVER_URL=
